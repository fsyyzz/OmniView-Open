# ==========================================
# OmniView Git 忽略配置
# ==========================================

# --- 依赖与包管理器 ---
node_modules/
.pnpm-store/
.yarn/
.yarn-cache/

# --- 构建与打包产物 ---
dist/
dist-ssr/
build/
out/
*.vsix
*.tsbuildinfo

# --- 日志与排错 ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- 单元测试与覆盖率 ---
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/

# --- 环境变量与私密配置 ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env.example

# --- 编辑器与 IDE 临时配置 ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

# --- 缓存文件 ---
.cache/
.parcel-cache/
.vite/
.eslintcache
.stylelintcache
*.cache

# --- 操作系统临时文件 ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- 备份与临时文件 ---
*.swp
*.swo
*~
*.bak
*.tmp
*.temp


