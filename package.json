{
  "name": "omniview",
  "private": true,
  "version": "0.14.0",
  "displayName": "OmniView",
  "description": "OmniView 多格式文件渲染与预览插件",
  "publisher": "zhouzan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fsyyzz/OmniView-Open"
  },
  "bugs": {
    "url": "https://github.com/fsyyzz/OmniView/issues"
  },
  "homepage": "https://github.com/fsyyzz/OmniView#readme",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=24.0.0"
  },
  "main": "./dist/extension.cjs",
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:omniview.editor",
    "onCommand:omniview.openSidePreview",
    "onCommand:omniview.openSideBySide",
    "onCommand:omniview.openSource"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "omniview.editor",
        "displayName": "OmniView 文件渲染器",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "*.okf"
          },
          {
            "filenamePattern": "*.puml"
          },
          {
            "filenamePattern": "*.plantuml"
          },
          {
            "filenamePattern": "*.iuml"
          },
          {
            "filenamePattern": "*.mmd"
          },
          {
            "filenamePattern": "*.mermaid"
          },
          {
            "filenamePattern": "*.dot"
          },
          {
            "filenamePattern": "*.gv"
          },
          {
            "filenamePattern": "*.svg"
          },
          {
            "filenamePattern": "*.pdf"
          },
          {
            "filenamePattern": "*.epub"
          },
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.pptx"
          },
          {
            "filenamePattern": "*.xlsx"
          },
          {
            "filenamePattern": "*.xls"
          },
          {
            "filenamePattern": "*.xlsm"
          },
          {
            "filenamePattern": "*.xltx"
          },
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.json"
          },
          {
            "filenamePattern": "*.yaml"
          },
          {
            "filenamePattern": "*.yml"
          },
          {
            "filenamePattern": "*.xml"
          },
          {
            "filenamePattern": "*.ts"
          },
          {
            "filenamePattern": "*.tsx"
          },
          {
            "filenamePattern": "*.js"
          },
          {
            "filenamePattern": "*.jsx"
          },
          {
            "filenamePattern": "*.txt"
          },
          {
            "filenamePattern": "*.markmap"
          },
          {
            "filenamePattern": "*.mm"
          },
          {
            "filenamePattern": "*.mindmap"
          },
          {
            "filenamePattern": "*.km"
          },
          {
            "filenamePattern": "*.ipynb"
          },
          {
            "filenamePattern": "*.typ"
          },
          {
            "filenamePattern": "*.typst"
          },
          {
            "filenamePattern": "*.excalidraw"
          },
          {
            "filenamePattern": "*.egn"
          },
          {
            "filenamePattern": "*.domainstory"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "omniview.openSidePreview",
        "title": "OmniView: 在侧边打开预览",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "omniview.openSource",
        "title": "OmniView: 打开源文件编辑",
        "icon": "$(code)"
      },
      {
        "command": "omniview.openSideBySide",
        "title": "OmniView: 打开并排协同 (原生源码编辑 + 实时渲染预览)",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "omniview.openSettings",
        "title": "OmniView: 打开插件设置 (Configure Settings)",
        "icon": "$(settings-gear)"
      },
      {
        "command": "omniview.togglePreviewLock",
        "title": "OmniView: 锁定/解锁预览跟随 (Toggle Preview Lock)",
        "icon": "$(lock)"
      },
      {
        "command": "omniview.showLogs",
        "title": "OmniView: 打开日志"
      }
    ],
    "keybindings": [
      {
        "command": "omniview.openSidePreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorTextFocus && resourceExtname =~ /\\.(md|markdown|okf|puml|plantuml|iuml|mmd|mermaid|dot|gv|svg|pdf|epub|docx|pptx|xlsx|xls|xlsm|xltx|csv|tsv|json|yaml|yml|xml|ts|tsx|js|jsx|txt|markmap|mm|mindmap|km|ipynb|typ|typst|excalidraw|egn|domainstory)$/i"
      },
      {
        "command": "omniview.openSidePreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && resourceExtname =~ /\\.(md|markdown|okf|puml|plantuml|iuml|mmd|mermaid|dot|gv|svg|pdf|epub|docx|pptx|xlsx|xls|xlsm|xltx|csv|tsv|json|yaml|yml|xml|ts|tsx|js|jsx|txt|markmap|mm|mindmap|km|ipynb|typ|typst|excalidraw|egn|domainstory)$/i"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "omniview.openSidePreview",
          "when": "resourceExtname =~ /\\.(md|markdown|okf|puml|plantuml|iuml|mmd|mermaid|dot|gv|svg|pdf|epub|docx|pptx|xlsx|xls|xlsm|xltx|csv|tsv|json|yaml|yml|xml|ts|tsx|js|jsx|txt|markmap|mm|mindmap|km|ipynb|typ|typst|excalidraw|egn|domainstory)$/i && activeCustomEditorId != 'omniview.editor'",
          "group": "navigation"
        },
        {
          "command": "omniview.togglePreviewLock",
          "when": "activeCustomEditorId == 'omniview.editor'",
          "group": "navigation@1"
        },
        {
          "command": "omniview.openSource",
          "when": "activeCustomEditorId == 'omniview.editor'",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "omniview.openSideBySide",
          "when": "resourceExtname =~ /\\.(md|markdown|okf|puml|plantuml|iuml|mmd|mermaid|dot|gv|svg|pdf|epub|docx|pptx|xlsx|xls|xlsm|xltx|csv|tsv|json|yaml|yml|xml|ts|tsx|js|jsx|txt|markmap|mm|mindmap|km|ipynb|typ|typst|excalidraw|egn|domainstory)$/i",
          "group": "omniview@1"
        },
        {
          "command": "omniview.openSidePreview",
          "when": "resourceExtname =~ /\\.(md|markdown|okf|puml|plantuml|iuml|mmd|mermaid|dot|gv|svg|pdf|epub|docx|pptx|xlsx|xls|xlsm|xltx|csv|tsv|json|yaml|yml|xml|ts|tsx|js|jsx|txt|markmap|mm|mindmap|km|ipynb|typ|typst|excalidraw|egn|domainstory)$/i",
          "group": "omniview@2"
        }
      ]
    },
    "configuration": {
      "title": "OmniView",
      "properties": {
        "omniview.preview.theme": {
          "type": "string",
          "default": "system",
          "enum": [
            "system",
            "dark",
            "light",
            "sepia",
            "nord",
            "dracula",
            "forest",
            "solarized",
            "midnight",
            "cyber"
          ],
          "markdownDescription": "渲染工作台默认色彩主题。设置为 `system` 将自动继承当前 VS Code 编辑器活动主题并实时跟随宿主外观。"
        },
        "omniview.preview.density": {
          "type": "string",
          "default": "compact",
          "enum": [
            "compact",
            "standard",
            "comfortable"
          ],
          "description": "默认排版紧凑密度与行距模式。"
        },
        "omniview.preview.fontSize": {
          "type": "number",
          "default": 15,
          "minimum": 12,
          "maximum": 24,
          "description": "预览排版基准正文字号 (px)。"
        },
        "omniview.preview.contentWidth": {
          "type": "string",
          "default": "standard",
          "enum": [
            "narrow",
            "standard",
            "wide",
            "full"
          ],
          "description": "文档与图表内容区域默认最大宽度约束。"
        },
        "omniview.editor.scrollSync": {
          "type": "boolean",
          "default": true,
          "description": "是否开启源码编辑器与预览视口之间的高精度双向滚动与光标行同步。"
        },
        "omniview.editor.wordWrap": {
          "type": "boolean",
          "default": true,
          "description": "源码与文本编辑模式下是否默认开启自动换行。"
        },
        "omniview.editor.showLineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "代码与源码查看器是否显示行号槽。"
        },
        "omniview.plantuml.serverUrl": {
          "type": "string",
          "default": "https://www.plantuml.com/plantuml",
          "format": "uri",
          "description": "PlantUML 图表渲染服务器地址（支持指向企业内部或团队私有部署的 PlantUML 服务实例）。"
        },
        "omniview.knowledge.enableOkfRendering": {
          "type": "boolean",
          "default": true,
          "description": "是否开启 OKF (Open Knowledge Format) 多维知识图谱扩展渲染引擎。"
        }
      }
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:webview": "vite build",
    "build:extension": "esbuild src/extension/extension.ts --bundle --outfile=dist/extension.cjs --external:vscode --format=cjs --platform=node",
    "build:plugin": "npm run build:webview && npm run build:extension",
    "package:vsix": "npm run build:plugin && vsce package --no-dependencies && node scripts/check-vsix-contents.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:structure": "node scripts/analyze-structure.mjs",
    "test": "(esbuild scripts/test-diagram-diagnostics.mjs --bundle --platform=node | node) && (esbuild scripts/test-mindmap-driver.mjs --bundle --platform=node | node) && (esbuild scripts/test-settings-storage.mjs --bundle --platform=node | node) && (esbuild scripts/test-a4-print-pagination.mjs --bundle --platform=node | node) && (esbuild scripts/test-csv-utils.mjs --bundle --platform=node | node) && (esbuild scripts/test-csv-profiling.mjs --bundle --platform=node | node) && (esbuild scripts/test-security-sanitizer.mjs --bundle --platform=node | node) && (esbuild scripts/test-driver-routing.mjs --bundle --platform=node | node) && (esbuild scripts/test-svg-utils.mjs --bundle --platform=node | node) && (esbuild scripts/test-table-utils.mjs --bundle --platform=node | node) && (esbuild scripts/test-structured-data.mjs --bundle --platform=node | node) && (esbuild scripts/test-okf-parser.mjs --bundle --platform=node | node) && (esbuild scripts/test-undo-redo.mjs --bundle --platform=node | node) && (esbuild scripts/test-print-bridge.mjs --bundle --platform=node | node) && (esbuild scripts/test-dom-search-highlighter.mjs --bundle --platform=node | node) && (esbuild scripts/test-plantuml-url.mjs --bundle --platform=node | node) && node scripts/test-i18n.mjs && node scripts/test-markdown-callout-task.mjs && (esbuild scripts/test-markdown-footnotes.mjs --bundle --platform=node | node) && (esbuild scripts/test-markdown-wiki-links.mjs --bundle --platform=node | node) && (esbuild scripts/test-markdown-pandoc-extras.mjs --bundle --platform=node | node) && node scripts/test-markdown-outline.mjs && node scripts/test-markdown-print-export.mjs && node scripts/test-webview-save-writeback.mjs && node scripts/test-presentation-outline-restore.mjs && node scripts/test-native-theme.mjs && (esbuild scripts/test-scroll-sync.mjs --bundle --platform=node | node) && node scripts/test-lazy-viewport-block.mjs && (esbuild scripts/test-notebook-parser.mjs --bundle --platform=node | node) && (esbuild scripts/test-typst-engine.mjs --bundle --platform=node | node) && (esbuild scripts/test-a4-typography-engine.mjs --bundle --platform=node | node) && (esbuild scripts/test-excalidraw.mjs --bundle --platform=node | node) && (esbuild scripts/test-diagram-playback.mjs --bundle --platform=node | node) && (esbuild scripts/test-domainstory-engine.mjs --bundle --platform=node | node) && (esbuild scripts/test-epub-engine.mjs --bundle --platform=node | node) && (esbuild scripts/test-docx-engine.mjs --bundle --platform=node | node) && (esbuild scripts/test-pptx-engine.mjs --bundle --platform=node | node) && (esbuild scripts/test-xlsx-engine.mjs --bundle --platform=node | node) && node scripts/test-check-vsix-contents.mjs",
    "verify": "npm run check:structure && npm run lint && npm run test && npm run build:plugin",
    "vscode:prepublish": "npm run build:plugin"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/utils": "^0.1.5",
    "@hpcc-js/wasm-graphviz": "^1.29.0",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@types/js-yaml": "^4.0.9",
    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.14",
    "js-yaml": "^5.4.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.11",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^4.10.38",
    "plantuml-encoder": "^1.4.0",
    "prismjs": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/dompurify": "^3.2.0",
    "@types/jszip": "^3.4.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.14.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
